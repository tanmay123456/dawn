{%- comment -%}
  Zevaraz — Full-bleed image. Renders nothing without an image.
{%- endcomment -%}

{% render 'zev-assets' %}

{%- if section.settings.image -%}
  <div class="zev-full" style="--zev-full-h: {{ section.settings.height }}px;">
    {{ section.settings.image
       | image_url: width: 3000
       | image_tag:
           loading: 'lazy',
           sizes: '100vw',
           widths: '750,1100,1500,2000,2600,3000',
           class: 'zev-full__image',
           alt: section.settings.image.alt }}
  </div>
{%- endif -%}

{%- style -%}
  .zev-full { height: var(--zev-full-h, 520px); background: var(--zev-stone, #F1EEE8); }
  .zev-full__image { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 749px) { .zev-full { height: 260px; } }
{%- endstyle -%}

{% schema %}
{
  "name": "Full-bleed image",
  "tag": "section",
  "class": "zev-full-section",
  "settings": [
    { "id": "image", "type": "image_picker", "label": "Image" },
    { "id": "height", "type": "range", "label": "Height", "min": 260, "max": 720, "step": 20, "unit": "px", "default": 520 }
  ],
  "presets": [{ "name": "Full-bleed image" }]
}
{% endschema %}
