{%- comment -%}
  Zevaraz — "Wear it with" (PDP, below the fold)

  Source order:
    1. Complementary products set in the free Search & Discovery app. They are
       stored on the product itself, so this renders server-side with no
       JavaScript and no recommendations request.
    2. Failing that, other pieces from the same collection.
  Four products, simplified card: image, title, price. No badges, no chips.
{%- endcomment -%}

{% render 'zev-assets' %}

{%- liquid
  assign limit = section.settings.count | default: 4
  assign picks = product.metafields.shopify--discovery--product_recommendation.complementary_products.value
  assign source = 'complementary'

  if picks == blank or picks.size == 0
    assign source = 'collection'
    assign pool = product.collections.first
  endif
-%}

<div class="zev-wear">
  <h2 class="zev-wear__heading">{{ section.settings.heading | default: 'Wear it with' }}</h2>

  <div class="zev-wear__grid">
    {%- if source == 'complementary' -%}
      {%- for item in picks limit: limit -%}
        {%- render 'zev-wear-card', item: item -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign shown = 0 -%}
      {%- for item in pool.products -%}
        {%- if item.id != product.id and shown < limit -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- render 'zev-wear-card', item: item -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .zev-wear {
    padding: 70px var(--zev-gutter, 56px) 84px;
    background: var(--zev-ivory, #F8F8F6);
  }
  .zev-wear__heading {
    margin: 0 0 28px;
    font: 600 30px/1.15 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-wear__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .zev-wearcard {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--zev-line, #E6E2DA);
    border-radius: var(--zev-radius, 0);
    box-shadow: var(--zev-shadow, none);
    text-decoration: none;
  }
  .zev-wearcard__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--zev-stone, #F1EEE8);
  }
  .zev-wearcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s ease-out;
  }
  .zev-wearcard:hover .zev-wearcard__media img { transform: scale(1.03); }
  .zev-wearcard__meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: var(--zev-card-pad, 22px);
  }
  .zev-wearcard__title {
    margin: 0;
    font: 400 16px/1.35 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-wearcard__price {
    margin: 0;
    white-space: nowrap;
    font: 500 14px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-ink, #1C1C1C);
  }

  @media (max-width: 989px) {
    .zev-wear__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    .zev-wear { padding: 36px var(--zev-gutter, 20px) 40px; }
    .zev-wear__heading { margin-bottom: 18px; font-size: 25px; }
    .zev-wear__grid { gap: var(--zev-grid-gap, 14px); }
    .zev-wearcard__title { font-size: 15px; }
    .zev-wearcard__price { font-size: 13px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Wear it with",
  "tag": "section",
  "class": "zev-wear-section",
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "Wear it with" },
    { "id": "count", "type": "range", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
