{%- comment -%}
  Zevaraz — Hero (homepage section 1.3)
  One image, no slider. The overlay direction changes between mobile and
  desktop: a left-to-right scrim on desktop, a bottom-up scrim on mobile.
  Headline is three short lines. Put each on its own line in the setting.
{%- endcomment -%}

{% render 'zev-assets' %}

<div class="zev-hero">
  {%- if section.settings.image -%}
    {{ section.settings.image
       | image_url: width: 3000
       | image_tag:
           loading: 'eager',
           fetchpriority: 'high',
           sizes: '100vw',
           widths: '750,1100,1500,2000,2600,3000',
           class: 'zev-hero__image',
           alt: section.settings.image.alt | default: section.settings.heading }}
  {%- endif -%}

  <div class="zev-hero__scrim"></div>

  <div class="zev-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="zev-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="zev-hero__heading">
        {%- assign lines = section.settings.heading | strip | newline_to_br | split: '<br />' -%}
        {%- for line in lines -%}
          {%- assign clean = line | strip -%}
          {%- if clean != blank -%}<span>{{ clean }}</span>{%- endif -%}
        {%- endfor -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="zev-hero__body">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div class="zev-hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="zev-hero__btn zev-hero__btn--primary" href="{{ section.settings.cta_link | default: '#' }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="zev-hero__btn zev-hero__btn--ghost" href="{{ section.settings.cta2_link | default: '#' }}">
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .zev-hero {
    position: relative;
    height: 620px;
    background: var(--zev-graphite, #1C1C1C);
    overflow: hidden;
  }
  .zev-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .92;
  }
  .zev-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(28,28,28,.72) 0%, rgba(28,28,28,.34) 46%, rgba(28,28,28,0) 72%);
  }
  .zev-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 22px;
    height: 100%;
    max-width: 820px;
    padding: 0 96px;
  }
  .zev-hero__eyebrow {
    margin: 0;
    font: 500 11px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--zev-silver, #C0C0C0);
  }
  .zev-hero__heading {
    display: flex;
    flex-direction: column;
    margin: 0;
    font: 600 62px/1.08 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-on-dark, #F8F8F6);
  }
  .zev-hero__body {
    margin: 0;
    max-width: 460px;
    font: 400 17px/1.7 var(--zev-font-text, 'Montserrat', sans-serif);
    color: #E4E1DA;
  }
  .zev-hero__actions { display: flex; gap: 16px; flex-wrap: wrap; }
  .zev-hero__btn {
    display: inline-block;
    padding: 17px 34px;
    font: 500 14px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color .15s ease, color .15s ease;
  }
  .zev-hero__btn--primary {
    background: var(--zev-emerald, #0F6452);
    color: #fff;
  }
  .zev-hero__btn--primary:hover { background: var(--zev-emerald-hover, #0C5343); }
  .zev-hero__btn--ghost {
    border: 1px solid rgba(248,248,246,.5);
    color: var(--zev-on-dark, #F8F8F6);
  }
  .zev-hero__btn--ghost:hover { background: rgba(248,248,246,.12); }

  @media (max-width: 749px) {
    .zev-hero { height: 470px; }
    .zev-hero__scrim {
      background: linear-gradient(180deg, rgba(28,28,28,.2) 0%, rgba(28,28,28,.78) 68%);
    }
    .zev-hero__content {
      justify-content: flex-end;
      gap: 16px;
      max-width: none;
      padding: 24px 22px 28px;
    }
    .zev-hero__heading { font-size: 34px; }
    .zev-hero__body { font-size: 15px; }
    /* The secondary CTA drops; the primary goes full width. */
    .zev-hero__actions { width: 100%; }
    .zev-hero__btn--ghost { display: none; }
    .zev-hero__btn--primary { width: 100%; text-align: center; min-height: 44px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "zev-hero-section",
  "settings": [
    {
      "id": "image",
      "type": "image_picker",
      "label": "Image",
      "info": "3000px wide, cropped so the left half is quiet enough to hold text. The old slider images were not shot for overlaid type."
    },
    { "id": "eyebrow", "type": "text", "label": "Eyebrow", "default": "Collection 02 · Nira" },
    {
      "id": "heading",
      "type": "textarea",
      "label": "Headline",
      "info": "Three short lines, one per line. Never one long line.",
      "default": "Indian heritage.\nModern minimal.\nReal silver."
    },
    { "id": "body", "type": "text", "label": "Body" },
    { "id": "cta_label", "type": "text", "label": "Primary button", "default": "Shop Nira" },
    { "id": "cta_link", "type": "url", "label": "Primary button link" },
    { "id": "cta2_label", "type": "text", "label": "Secondary button", "info": "Hidden on mobile.", "default": "All collections" },
    { "id": "cta2_link", "type": "url", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
