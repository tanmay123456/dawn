{%- comment -%}
  Zevaraz — Collection navigator (homepage section 1.5)
  The fix for problem 4: route by mood, not by product type.

  Per card, the owner edits nothing here. The name, description and image come
  from the collection itself; the number and tag line come from collection
  metafields so she can change them in Shopify admin without a developer:

    custom.collection_number   single line text   e.g. "Collection 01"
    custom.tag_line            single line text   e.g. "Kundan · Heritage"
    custom.from_price          single line text   optional. Overrides the
                                                  computed lowest price.
{%- endcomment -%}

{% render 'zev-assets' %}

<div class="zev-nav-collections">
  <div class="zev-nav-collections__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="zev-nav-collections__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="zev-nav-collections__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="zev-nav-collections__all" href="{{ section.settings.link_url | default: '/collections' }}">
        {{ section.settings.link_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="zev-nav-collections__grid">
    {%- for block in section.blocks -%}
      {%- assign c = collections[block.settings.collection] -%}
      {%- if c != blank and c.handle -%}
        {%- liquid
          assign number = block.settings.number | default: c.metafields.custom.collection_number
          assign tag_line = block.settings.tag_line | default: c.metafields.custom.tag_line
          assign from_price = c.metafields.custom.from_price | default: ''
          if from_price == blank
            assign low = 0
            for p in c.products limit: 50
              if low == 0 or p.price < low
                assign low = p.price
              endif
            endfor
            if low > 0
              assign from_price = low | money_without_trailing_zeros
            endif
          endif
          assign card_image = block.settings.image | default: c.featured_image
        -%}
        <a class="zev-nav-card" href="{{ c.url }}" {{ block.shopify_attributes }}>
          <span class="zev-nav-card__media">
            {%- if card_image -%}
              {{ card_image
                 | image_url: width: 1000
                 | image_tag:
                     loading: 'lazy',
                     sizes: '(min-width: 990px) 25vw, 50vw',
                     widths: '300,450,600,800,1000',
                     class: 'zev-nav-card__image',
                     alt: c.title }}
            {%- endif -%}
            {%- if number != blank -%}
              <span class="zev-nav-card__number">{{ number }}</span>
            {%- endif -%}
          </span>

          <span class="zev-nav-card__body">
            <span class="zev-nav-card__name">{{ c.title }}</span>
            {%- if tag_line != blank -%}
              <span class="zev-nav-card__tag">{{ tag_line }}</span>
            {%- endif -%}
            {%- if c.description != blank -%}
              <span class="zev-nav-card__desc">{{ c.description | strip_html | truncatewords: 30 }}</span>
            {%- endif -%}
            {%- if from_price != blank -%}
              <span class="zev-nav-card__from">From {{ from_price }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- style -%}
  .zev-nav-collections {
    background: var(--zev-ivory, #F8F8F6);
    padding: var(--zev-section, 88px) var(--zev-gutter, 56px);
  }
  .zev-nav-collections__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
  }
  .zev-nav-collections__eyebrow {
    margin: 0 0 12px;
    font: 500 11px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--zev-emerald, #0F6452);
  }
  .zev-nav-collections__heading {
    margin: 0;
    font: 600 var(--zev-h2, 40px)/1.12 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-nav-collections__all {
    flex: none;
    font: 400 13px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-ink, #1C1C1C);
    text-decoration: none;
    border-bottom: 1px solid var(--zev-silver, #C0C0C0);
    padding-bottom: 5px;
    transition: border-color .15s ease;
  }
  .zev-nav-collections__all:hover { border-color: var(--zev-ink, #1C1C1C); }

  .zev-nav-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .zev-nav-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--zev-line, #E6E2DA);
    text-decoration: none;
  }
  .zev-nav-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--zev-stone, #F1EEE8);
  }
  .zev-nav-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease-out;
  }
  .zev-nav-card:hover .zev-nav-card__image { transform: scale(1.03); }
  .zev-nav-card__number {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 10px;
    background: rgba(248,248,246,.94);
    font: 500 10px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-nav-card__body {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 24px 22px 26px;
  }
  .zev-nav-card__name {
    font: 600 26px/1.2 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-nav-card__tag {
    font: 500 11px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--zev-emerald, #0F6452);
  }
  .zev-nav-card__desc {
    font: 400 13px/1.6 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-quiet, #6B6764);
  }
  .zev-nav-card__from {
    margin-top: 8px;
    font: 400 12px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-taupe, #A8999C);
  }

  @media (max-width: 989px) {
    .zev-nav-collections__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 749px) {
    .zev-nav-collections__head { flex-direction: column; align-items: flex-start; gap: 14px; margin-bottom: 22px; }
    .zev-nav-collections__grid { gap: 12px; }
    .zev-nav-card__media { aspect-ratio: 1 / 1; }
    .zev-nav-card__body { padding: 16px 14px 18px; gap: 7px; }
    .zev-nav-card__name { font-size: 20px; }
    .zev-nav-card__desc { display: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Collection navigator",
  "tag": "section",
  "class": "zev-nav-collections-section",
  "max_blocks": 8,
  "settings": [
    { "id": "eyebrow", "type": "text", "label": "Eyebrow", "default": "Four collections" },
    { "id": "heading", "type": "text", "label": "Heading", "default": "Start with the mood, not the metal" },
    { "id": "link_label", "type": "text", "label": "Link label", "default": "View all" },
    { "id": "link_url", "type": "url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "id": "collection", "type": "collection", "label": "Collection" },
        { "id": "image", "type": "image_picker", "label": "Image", "info": "Optional. Falls back to the collection image." },
        { "id": "number", "type": "text", "label": "Number", "info": "Optional. Falls back to the collection metafield custom.collection_number." },
        { "id": "tag_line", "type": "text", "label": "Tag line", "info": "Optional. Falls back to the collection metafield custom.tag_line." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection navigator",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
