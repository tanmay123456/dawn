{%- comment -%}
  Zevaraz — Instagram strip (homepage section 1.9)
  Deliberately not a feed app: five images the owner chooses, so the strip is
  fast and always on-brand. Empty slots render nothing.
{%- endcomment -%}

{% render 'zev-assets' %}

{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.image
      assign filled = filled | plus: 1
    endif
  endfor
-%}

{%- if filled > 0 -%}
  <div class="zev-ig">
    <div class="zev-ig__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="zev-ig__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        <a class="zev-ig__handle" href="{{ section.settings.handle_url | default: '#' }}" target="_blank" rel="noopener">
          {{ section.settings.handle }}
        </a>
      {%- endif -%}
    </div>

    <div class="zev-ig__grid" style="--zev-ig-count: {{ filled }};">
      {%- for block in section.blocks -%}
        {%- if block.settings.image -%}
          <a class="zev-ig__cell" href="{{ block.settings.link | default: section.settings.handle_url | default: '#' }}"
             target="_blank" rel="noopener" {{ block.shopify_attributes }}>
            {{ block.settings.image
               | image_url: width: 800
               | image_tag:
                   loading: 'lazy',
                   sizes: '(min-width: 750px) 20vw, 45vw',
                   widths: '250,400,600,800',
                   class: 'zev-ig__image',
                   alt: block.settings.image.alt | default: section.settings.handle }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- style -%}
  .zev-ig {
    background: var(--zev-ivory, #F8F8F6);
    padding: 80px var(--zev-gutter, 56px);
  }
  .zev-ig__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }
  .zev-ig__heading {
    margin: 0;
    font: 600 32px/1.14 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-ig__handle {
    font: 400 13px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-taupe, #A8999C);
    text-decoration: none;
  }
  .zev-ig__handle:hover { color: var(--zev-ink, #1C1C1C); }
  .zev-ig__grid {
    display: grid;
    grid-template-columns: repeat(var(--zev-ig-count, 5), 1fr);
    gap: 12px;
  }
  .zev-ig__cell {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--zev-stone, #F1EEE8);
  }
  .zev-ig__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease-out;
  }
  .zev-ig__cell:hover .zev-ig__image { transform: scale(1.03); }

  @media (max-width: 989px) {
    .zev-ig__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 749px) {
    .zev-ig { padding: 36px var(--zev-gutter, 20px); }
    .zev-ig__heading { font-size: 24px; }
    .zev-ig__grid { grid-template-columns: 1fr 1fr; gap: 8px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Instagram strip",
  "tag": "section",
  "class": "zev-ig-section",
  "max_blocks": 8,
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "Worn in real light" },
    { "id": "handle", "type": "text", "label": "Handle", "default": "@zevaraz.silver" },
    { "id": "handle_url", "type": "url", "label": "Profile link" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "id": "image", "type": "image_picker", "label": "Image" },
        { "id": "link", "type": "url", "label": "Link", "info": "Optional. Falls back to the profile link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram strip",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
