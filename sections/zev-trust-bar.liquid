{%- comment -%}
  Zevaraz — Trust bar (homepage section 1.4)
  Stone scheme. Four blocks, desktop row / mobile 2x2 or marquee.
  All copy is editable in the theme editor. Renders nothing if empty.
{%- endcomment -%}

{% render 'zev-assets' %}

{%- liquid
  assign has_items = false
  for block in section.blocks
    if block.settings.title != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- if has_items -%}
  <div class="zev-trust zev-trust--{{ section.settings.mobile_layout }}">
    <div class="zev-trust__track">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          <div class="zev-trust__item" {{ block.shopify_attributes }}>
            <p class="zev-trust__title">{{ block.settings.title }}</p>
            {%- if block.settings.note != blank -%}
              <p class="zev-trust__note">{{ block.settings.note }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Duplicated once so the mobile marquee loops seamlessly {%- endcomment -%}
      {%- if section.settings.mobile_layout == 'marquee' -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.title != blank -%}
            <div class="zev-trust__item" aria-hidden="true">
              <p class="zev-trust__title">{{ block.settings.title }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- style -%}
  .zev-trust {
    background: var(--zev-stone, #F1EEE8);
    border-bottom: 1px solid var(--zev-line, #E6E2DA);
    overflow: hidden;
  }
  .zev-trust__track {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
  }
  .zev-trust__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px 34px;
    border-right: 1px solid var(--zev-line, #E6E2DA);
  }
  .zev-trust__item:last-child { border-right: 0; }
  /* The duplicated track is for the mobile marquee only. */
  .zev-trust__item[aria-hidden='true'] { display: none; }
  .zev-trust__title {
    margin: 0;
    font: 600 13px/1.3 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-trust__note {
    margin: 0;
    font: 400 12px/1.5 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-taupe, #A8999C);
  }

  @media (max-width: 749px) {
    .zev-trust--grid .zev-trust__track {
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--zev-line, #E6E2DA);
    }
    .zev-trust--grid .zev-trust__item {
      background: var(--zev-stone, #F1EEE8);
      padding: 14px 16px;
      border-right: 0;
    }
    .zev-trust--grid .zev-trust__note { display: none; }

    .zev-trust--marquee .zev-trust__track {
      display: flex;
      width: max-content;
      gap: 26px;
      padding: 13px 0;
      animation: zev-marquee 22s linear infinite;
    }
    .zev-trust--marquee .zev-trust__item[aria-hidden='true'] { display: flex; }
    .zev-trust--marquee .zev-trust__item {
      flex-direction: row;
      padding: 0;
      border-right: 0;
      white-space: nowrap;
    }
    .zev-trust--marquee .zev-trust__title {
      font-weight: 400;
      font-size: 11px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--zev-quiet, #6B6764);
    }
    .zev-trust--marquee .zev-trust__note { display: none; }
  }

  @keyframes zev-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .zev-trust--marquee .zev-trust__track { animation: none; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "zev-trust-section",
  "max_blocks": 4,
  "settings": [
    {
      "id": "mobile_layout",
      "type": "select",
      "label": "Mobile layout",
      "options": [
        { "value": "grid", "label": "Two by two grid" },
        { "value": "marquee", "label": "Scrolling marquee" }
      ],
      "default": "marquee"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "id": "title", "type": "text", "label": "Title" },
        { "id": "note", "type": "text", "label": "Supporting line", "info": "Hidden on mobile." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "title": "92.5 hallmarked silver", "note": "BIS stamped on every piece" } },
        { "type": "item", "settings": { "title": "Direct from Jaipur", "note": "Our own workshop, no middlemen" } },
        { "type": "item", "settings": { "title": "7-day easy returns", "note": "Unworn, in original packaging" } },
        { "type": "item", "settings": { "title": "Free shipping over ₹2,000", "note": "Insured, tracked, 3-5 days" } }
      ]
    }
  ]
}
{% endschema %}
