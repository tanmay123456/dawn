{%- comment -%}
  Zevaraz — Image band (homepage section 1.8 "Baby & Kids")
  Two equal columns, image one side and copy the other. On mobile the order is
  deliberate: heading, then image, then body, then link.
{%- endcomment -%}

{% render 'zev-assets' %}

<div class="zev-band zev-band--{{ section.settings.scheme }} zev-band--image-{{ section.settings.image_side }}">
  <div class="zev-band__media">
    {%- if section.settings.image -%}
      {{ section.settings.image
         | image_url: width: 1600
         | image_tag:
             loading: 'lazy',
             sizes: '(min-width: 750px) 50vw, 100vw',
             widths: '450,700,900,1200,1600',
             class: 'zev-band__image',
             alt: section.settings.image.alt | default: section.settings.heading }}
    {%- endif -%}
  </div>

  <div class="zev-band__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="zev-band__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="zev-band__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="zev-band__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="zev-band__link" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .zev-band {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .zev-band--stone    { background: var(--zev-stone, #F1EEE8); }
  .zev-band--ivory    { background: var(--zev-ivory, #F8F8F6); }
  .zev-band--graphite { background: var(--zev-graphite, #1C1C1C); }

  .zev-band--image-right .zev-band__media { order: 2; }
  .zev-band--image-right .zev-band__copy  { order: 1; }

  .zev-band__media { min-height: 460px; background: var(--zev-line-stone, #E0DCD4); }
  .zev-band__image { width: 100%; height: 100%; object-fit: cover; display: block; }

  .zev-band__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    padding: 80px 72px;
  }
  .zev-band__eyebrow {
    margin: 0;
    font: 500 11px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--zev-emerald, #0F6452);
  }
  .zev-band__heading {
    margin: 0;
    font: 600 var(--zev-h3, 38px)/1.14 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-band__body {
    max-width: 430px;
    font: 400 16px/1.7 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-body-soft, #5A5654);
  }
  .zev-band__body p { margin: 0; }
  .zev-band__link {
    font: 500 13px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--zev-ink, #1C1C1C);
    text-decoration: none;
    border-bottom: 1px solid var(--zev-silver, #C0C0C0);
    padding-bottom: 5px;
    transition: border-color .15s ease;
  }
  .zev-band__link:hover { border-color: var(--zev-ink, #1C1C1C); }

  .zev-band--graphite .zev-band__heading { color: var(--zev-on-dark, #F8F8F6); }
  .zev-band--graphite .zev-band__body { color: var(--zev-on-dark-soft, #D8D4CC); }
  .zev-band--graphite .zev-band__link { color: var(--zev-on-dark, #F8F8F6); }

  @media (max-width: 749px) {
    .zev-band { display: block; }
    .zev-band__copy { padding: 36px 20px; gap: 16px; }
    .zev-band__media { min-height: 0; aspect-ratio: 16 / 10; }
    .zev-band__heading { font-size: var(--zev-h3, 25px); }
    .zev-band__body { font-size: 15px; }
    /* Mobile order: heading, image, body, link. */
    .zev-band__copy { display: contents; }
    .zev-band__eyebrow { padding: 36px 20px 0; }
    .zev-band__heading { padding: 12px 20px 20px; }
    .zev-band__body { padding: 20px 20px 0; }
    .zev-band__link { margin: 16px 20px 36px; align-self: flex-start; display: inline-block; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Image band",
  "tag": "section",
  "class": "zev-band-section",
  "settings": [
    { "id": "image", "type": "image_picker", "label": "Image" },
    {
      "id": "image_side",
      "type": "select",
      "label": "Image side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "id": "scheme",
      "type": "select",
      "label": "Colour scheme",
      "options": [
        { "value": "stone", "label": "Stone" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "graphite", "label": "Graphite" }
      ],
      "default": "stone"
    },
    { "id": "eyebrow", "type": "text", "label": "Eyebrow", "default": "Baby & Kids" },
    { "id": "heading", "type": "text", "label": "Heading", "default": "Her first silver, and the one she keeps" },
    { "id": "body", "type": "richtext", "label": "Body" },
    { "id": "link_label", "type": "text", "label": "Link label", "default": "Shop baby & kids" },
    { "id": "link_url", "type": "url", "label": "Link" }
  ],
  "presets": [{ "name": "Image band" }]
}
{% endschema %}
