{%- comment -%}
  Zevaraz — Collection header (screen 2)
  Stone. Copy left, image right. One sentence of character before any filtering.

  The image comes from the collection's own Image field in admin
  (Products → Collections → [collection] → Image), never from a section
  setting. A section setting here would be shared by every collection,
  because all collections render through the one collection template —
  set it for Necklaces and Aabha, Kala and Ratna would change too.
  There is deliberately no image setting in the schema below, so that
  mistake cannot be made from the theme editor.

  Tag line comes from the collection metafield custom.tag_line, description
  from the collection's own description field. Nothing is hard-coded.
{%- endcomment -%}

{% render 'zev-assets' %}

{%- liquid
  assign tag_line = collection.metafields.custom.tag_line
  assign low = 0
  assign high = 0
  for p in collection.products limit: 50
    if low == 0 or p.price < low
      assign low = p.price
    endif
    if p.price > high
      assign high = p.price
    endif
  endfor
-%}

<div class="zev-chead">
  <div class="zev-chead__copy">
    <nav class="zev-chead__crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">·</span>
      <a href="{{ routes.collections_url }}">Collections</a>
      <span aria-hidden="true">·</span>
      <span aria-current="page">{{ collection.title }}</span>
    </nav>

    <h1 class="zev-chead__title">{{ collection.title }}</h1>

    {%- if tag_line != blank -%}
      <p class="zev-chead__tag">{{ tag_line }}</p>
    {%- endif -%}

    {%- if collection.description != blank -%}
      <div class="zev-chead__desc">{{ collection.description }}</div>
    {%- endif -%}

    {%- if collection.products_count > 0 -%}
      <p class="zev-chead__meta">
        {{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}
        {%- if low > 0 -%}
          <span aria-hidden="true"> · </span>
          {{ low | money_without_trailing_zeros }}
          {%- if high > low %} – {{ high | money_without_trailing_zeros }}{% endif -%}
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  {%- if collection.image -%}
    <div class="zev-chead__media">
      {{ collection.image
         | image_url: width: 1600
         | image_tag:
             loading: 'eager',
             sizes: '(min-width: 750px) 50vw, 100vw',
             widths: '450,700,900,1200,1600',
             class: 'zev-chead__image',
             alt: collection.title }}
    </div>
  {%- endif -%}
</div>

{%- style -%}
  .zev-chead {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--zev-stone, #F1EEE8);
    border-bottom: 1px solid var(--zev-line, #E6E2DA);
  }
  .zev-chead__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 16px;
    padding: 64px var(--zev-gutter, 56px);
  }
  .zev-chead__crumbs {
    display: flex;
    gap: 7px;
    font: 400 12px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-taupe, #A8999C);
  }
  .zev-chead__crumbs a { color: inherit; text-decoration: none; }
  .zev-chead__crumbs a:hover { color: var(--zev-ink, #1C1C1C); }
  .zev-chead__title {
    margin: 0;
    font: 600 52px/1.06 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-chead__tag {
    margin: 0;
    font: 500 11px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--zev-emerald, #0F6452);
  }
  .zev-chead__desc {
    max-width: 470px;
    font: 400 16px/1.7 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-body-soft, #5A5654);
  }
  .zev-chead__desc p { margin: 0 0 10px; }
  .zev-chead__desc p:last-child { margin-bottom: 0; }
  .zev-chead__meta {
    margin: 0;
    font: 400 13px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-taupe, #A8999C);
  }
  .zev-chead__media { min-height: 340px; background: var(--zev-line-stone, #E0DCD4); }
  .zev-chead__image { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 749px) {
    .zev-chead { display: block; }
    .zev-chead__copy { padding: 28px var(--zev-gutter, 20px); gap: 12px; }
    .zev-chead__title { font-size: 34px; }
    .zev-chead__desc { font-size: 15px; }
    .zev-chead__media { min-height: 0; aspect-ratio: 16 / 9; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Collection header",
  "tag": "section",
  "class": "zev-chead-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The image on this header comes from the collection itself. Set it under Products → Collections → open the collection → Image. There is no image setting here on purpose: this section is shared by every collection, so one setting would change all of them at once."
    }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
