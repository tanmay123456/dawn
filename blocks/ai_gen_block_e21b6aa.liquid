{% doc %}
  @prompt
    Create a collection list carousel section with the following features:
    - Horizontal scrolling carousel layout with no navigation arrows
    - Support for 9 or more collection items in an endless scrollable list
    - Circular images for each collection item
    - Text overlay on the images with adjustable font size setting
    - Mobile-optimized carousel that scrolls smoothly horizontally
    - Color scheme selector option for the section background and text
    - Minimal spacing between items for an edge-to-edge appearance
    - No visible scrollbar, smooth touch/swipe scrolling on mobile
    - Grid layout that displays multiple items at once (3-4 visible on mobile)
    - Settings to adjust image size and text size independently
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding: 40px 0;
  }

  .ai-collection-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 20px;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.image_size }}px;
    position: relative;
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-collection-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 50%;
  }

  .ai-collection-carousel-title-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    text-align: center;
    padding: 0 15px;
    margin: 0;
    line-height: 1.2;
    word-wrap: break-word;
  }

  .ai-collection-carousel-link-{{ ai_gen_id }} {
    text-decoration: none;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-item-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_size }}px;
    }

    .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_size }}px;
      height: {{ block.settings.mobile_image_size }}px;
    }

    .ai-collection-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-collection-carousel-{{ ai_gen_id }} {
      padding: 20px 0;
    }
  }

  .color-scheme-{{ ai_gen_id }} {
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-collection-carousel-track-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank %}
          <div class="ai-collection-carousel-item-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-collection-carousel-link-{{ ai_gen_id }}">
              <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 400 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-collection-carousel-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag }}
                {% endif %}
                <div class="ai-collection-carousel-overlay-{{ ai_gen_id }}">
                  <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-carousel-track-{{ ai_gen_id }}');
        this.setupTouchScroll();
      }

      setupTouchScroll() {
        if (!this.track) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.track.addEventListener('mousedown', (e) => {
          isDown = true;
          this.track.style.cursor = 'grabbing';
          startX = e.pageX - this.track.offsetLeft;
          scrollLeft = this.track.scrollLeft;
        });

        this.track.addEventListener('mouseleave', () => {
          isDown = false;
          this.track.style.cursor = 'grab';
        });

        this.track.addEventListener('mouseup', () => {
          isDown = false;
          this.track.style.cursor = 'grab';
        });

        this.track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.track.offsetLeft;
          const walk = (x - startX) * 2;
          this.track.scrollLeft = scrollLeft - walk;
        });

        this.track.style.cursor = 'grab';
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

