{%- comment -%}
  Buy box item 12 — the delivery panel.
  The date range is computed from today, never hard-coded. Ships from Jaipur in
  24 hours, then 4 to 7 days in transit, so the promise is one the workshop can
  actually keep.
{%- endcomment -%}
{%- liquid
  assign now = 'now' | date: '%s' | plus: 0
  assign day = 86400
  assign from_ts = now | plus: 345600
  assign to_ts = now | plus: 691200
  assign from_d = from_ts | date: '%-d'
  assign to_d = to_ts | date: '%-d %b'
-%}
<div class="zev-delivery">
  <p class="zev-delivery__line">Delivered {{ from_d }}–{{ to_d }} · Free insured shipping</p>
  <p class="zev-delivery__note">Ships from Jaipur in 24 hours. 7-day returns on unworn pieces. Hallmark certificate in the box.</p>
</div>
