{%- comment -%}
  Zevaraz — Product card
  Usage: {% render 'zev-product-card', product: product, show_quick_add: true %}

  Shared by homepage section 1.7, the collection grid, and PDP "Wear it with".
  Rules that must not drift:
    - No border radius, no shadow. A 1px hairline is the only separation.
    - Title in Playfair 400. Price in Montserrat 500. Never the other way round.
    - The tag badge and the sale badge render only when they have a value.
    - Image 1 is the S1 front catalog shot; image 2 is the S2 angled shot and
      is what the hover swaps to.
{%- endcomment -%}

{%- liquid
  assign tag_label = product.metafields.custom.card_badge | default: ''
  assign hover_image = product.media[1]
  assign on_sale = false
  if product.compare_at_price > product.price and product.compare_at_price > 0
    assign on_sale = true
  endif
-%}

<div class="zev-card">
  <a class="zev-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{ product.featured_media
         | image_url: width: 1200
         | image_tag:
             loading: 'lazy',
             sizes: '(min-width: 990px) 25vw, 50vw',
             widths: '300,450,600,900,1200',
             class: 'zev-card__image',
             alt: product.featured_media.alt | default: product.title }}
    {%- endif -%}

    {%- if hover_image -%}
      {{ hover_image
         | image_url: width: 1200
         | image_tag:
             loading: 'lazy',
             sizes: '(min-width: 990px) 25vw, 50vw',
             widths: '300,450,600,900,1200',
             class: 'zev-card__image zev-card__image--hover',
             alt: '' }}
    {%- endif -%}

    {%- if tag_label != blank -%}
      <span class="zev-card__badge">{{ tag_label }}</span>
    {%- elsif on_sale -%}
      <span class="zev-card__badge">Sale</span>
    {%- endif -%}

    <span class="zev-card__hallmark">925 &middot; BIS</span>

    {%- if show_quick_add and product.variants.size == 1 -%}
      <button
        class="zev-card__quick-add"
        type="button"
        name="add"
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      >Quick add</button>
    {%- endif -%}
  </a>

  <div class="zev-card__meta">
    <div class="zev-card__text">
      <a class="zev-card__title" href="{{ product.url }}">{{ product.title }}</a>
      {%- if product.metafields.custom.card_subtitle != blank -%}
        <p class="zev-card__sub">{{ product.metafields.custom.card_subtitle }}</p>
      {%- endif -%}
    </div>

    <p class="zev-card__price">
      {{ product.price | money_without_trailing_zeros }}
      {%- comment -%}
        Only ever show a compare-at price when it is a real, higher price.
        The live store currently renders "Rs. 0.00" struck through on several
        bangles because the field was left at zero.
      {%- endcomment -%}
      {%- if on_sale -%}
        <s class="zev-card__was">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
      {%- endif -%}
    </p>
  </div>
</div>

{%- style -%}
  .zev-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--zev-line, #E6E2DA);
    border-radius: var(--zev-radius, 0);
    box-shadow: var(--zev-shadow, none);
  }
  .zev-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--zev-stone, #F1EEE8);
  }
  .zev-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease-out, opacity .3s ease;
  }
  .zev-card__image--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .zev-card__media:hover .zev-card__image--hover { opacity: 1; }
  .zev-card__media:hover .zev-card__image { transform: scale(1.03); }

  .zev-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 10px;
    background: var(--zev-ivory, #F8F8F6);
    font: 500 10px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--zev-emerald, #0F6452);
  }
  .zev-card__hallmark {
    position: absolute;
    bottom: 14px;
    right: 14px;
    padding: 7px 11px;
    background: rgba(248, 248, 246, .94);
    font: 400 10px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .1em;
    color: var(--zev-quiet, #6B6764);
  }
  .zev-card__quick-add {
    position: absolute;
    inset: auto 0 0 0;
    padding: 14px 0;
    border: 0;
    background: rgba(28, 28, 28, .9);
    color: var(--zev-on-dark, #F8F8F6);
    font: 500 12px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    letter-spacing: .16em;
    text-transform: uppercase;
    cursor: pointer;
    transform: translateY(100%);
    transition: transform .2s ease-out;
  }
  .zev-card__media:hover .zev-card__quick-add,
  .zev-card__quick-add:focus-visible { transform: translateY(0); }

  .zev-card__meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    padding: var(--zev-card-pad, 22px);
  }
  .zev-card__text { display: flex; flex-direction: column; gap: 6px; }
  .zev-card__title {
    font: 400 18px/1.3 var(--zev-font-display, 'Playfair Display', serif);
    color: var(--zev-ink, #1C1C1C);
    text-decoration: none;
  }
  .zev-card__sub {
    margin: 0;
    font: 400 12px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-taupe, #A8999C);
  }
  .zev-card__price {
    margin: 0;
    white-space: nowrap;
    font: 500 16px/1 var(--zev-font-text, 'Montserrat', sans-serif);
    color: var(--zev-ink, #1C1C1C);
  }
  .zev-card__was {
    margin-left: 7px;
    font-size: 13px;
    color: var(--zev-taupe, #A8999C);
  }

  @media (max-width: 749px) {
    .zev-card__title { font-size: 16px; }
    .zev-card__price { font-size: 15px; }
    .zev-card__quick-add { display: none; }
  }

  @media (hover: none) {
    .zev-card__image--hover { display: none; }
  }
{%- endstyle -%}
